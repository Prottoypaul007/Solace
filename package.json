{
  "name": "tutortrack-mobile",
  "private": true,
  "version": "1.6.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "test": "node --experimental-strip-types --test tests/*.test.mjs",
    "preview": "vite preview",
    "server": "node --env-file-if-exists=.env --experimental-strip-types server/index.mjs",
    "migrate": "node --env-file-if-exists=.env --experimental-strip-types server/migrate.mjs",
    "setup:tutor": "node --env-file-if-exists=.env --experimental-strip-types server/setup-tutor.mjs",
    "backup:server": "node --env-file-if-exists=.env --experimental-strip-types server/backup-snapshot.mjs"
  },
  "dependencies": {
    "@awesome-cordova-plugins/sms": "^8.1.0",
    "@byteowls/capacitor-sms": "^7.0.0",
    "@capacitor/android": "^7.4.4",
    "@capacitor/cli": "^7.4.4",
    "@capacitor/core": "^7.4.4",
    "@ionic-native/sms": "^5.36.0",
    "better-auth": "^1.7.23",
    "clsx": "^2.1.0",
    "cordova-sms-plugin": "^1.0.4",
    "date-fns": "^3.3.1",
    "express": "^5.3.0",
    "lucide-react": "^0.344.0",
    "pg": "^8.23.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^6.22.0",
    "tailwind-merge": "^2.2.1",
    "uuid": "^9.0.1"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@types/uuid": "^9.0.8",
    "@vitejs/plugin-react": "^4.2.1",
    "autoprefixer": "^10.4.17",
    "esbuild": "^0.21.5",
    "postcss": "^8.4.35",
    "tailwindcss": "^3.4.1",
    "typescript": "^5.2.2",
    "vite": "^5.1.4"
  }
}
