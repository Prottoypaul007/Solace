# Keep this file as a template. Put real values in the ignored .env file.
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3005
SOLACE_APP_URL=http://localhost:3005
SOLACE_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://localhost
VITE_API_URL=http://localhost:3005

# Local-only SQLite mode. Do not use this mode on Render Free.
SOLACE_DATABASE_PATH=server/data/solace.sqlite

# Render Free + Neon: use Neon's pooled PostgreSQL URL. The app keeps its
# SQLite query engine in memory and saves versioned snapshots to Neon.
DATABASE_URL=

# One-time tutor setup. Remove SOLACE_SETUP_PASSWORD after running setup:tutor.
SOLACE_SETUP_EMAIL=
SOLACE_SETUP_PASSWORD=
SOLACE_SETUP_NAME=
